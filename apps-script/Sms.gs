function crmMockSmsSend_(student,kind,message){var phone=student.parentPhone||student.phone;if(!student.smsConsent)return {status:'SKIPPED',error:'NO_CONSENT'};if(!/^\+?[0-9]{9,15}$/.test(String(phone).replace(/[ -]/g,'')))return {status:'FAILED',error:'INVALID_PHONE'};return {status:'MOCK_SENT',providerId:'mock-'+crmId_()};}
function crmSendSms_(user,data){CRM.permission(user,['BOSS','ADMIN']);var student=crmFind_('Students',data.studentId),kind=data.kind||'MANUAL',message=data.message;crmRequire_({message:message},['message']);var key=student.id+'|'+kind+'|'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd');var seen=crmRows_('SmsLogs').filter(function(x){return x.dedupeKey===key&&x.status==='MOCK_SENT';})[0];if(seen)throw new Error('CONFLICT');var result=crmMockSmsSend_(student,kind,message);var log=crmInsert_('SmsLogs',{studentId:student.id,phone:student.parentPhone||student.phone,kind:kind,message:message,status:result.status,providerId:result.providerId||'',dedupeKey:key,error:result.error||''});crmAudit_(user,'SEND_SMS','SmsLogs',log.id,{kind:kind,status:result.status});return log;}
function crmRunPaymentReminders(){var debtors=crmDebtors_({id:'system',role:'BOSS',active:true});debtors.forEach(function(d){var s=crmFind_('Students',d.studentId),message='Avitseniya Academy: '+d.period+' uchun qarzdorlik '+d.debt+' UZS.';var key=s.id+'|DEBT|'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyy-MM-dd');if(!crmRows_('SmsLogs').some(function(x){return x.dedupeKey===key;})){var r=crmMockSmsSend_(s,'DEBT',message);crmInsert_('SmsLogs',{studentId:s.id,phone:s.parentPhone||s.phone,kind:'DEBT',message:message,status:r.status,providerId:r.providerId||'',dedupeKey:key,error:r.error||''});}});}
function crmInstallTriggers(){ScriptApp.getProjectTriggers().filter(function(t){return t.getHandlerFunction()==='crmRunPaymentReminders';}).forEach(function(t){ScriptApp.deleteTrigger(t);});ScriptApp.newTrigger('crmRunPaymentReminders').timeBased().everyDays(1).atHour(9).create();}
