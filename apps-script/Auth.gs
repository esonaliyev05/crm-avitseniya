function crmHash_(password,salt){ return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,salt+password)); }
function crmLogin_(data){ crmRequire_(data,['email','password']); var user=crmRows_('Users').filter(function(u){return String(u.email).toLowerCase()===String(data.email).toLowerCase() && (u.active===true||String(u.active)==='true');})[0]; if(!user || crmHash_(data.password,user.passwordSalt)!==user.passwordHash)throw new Error('UNAUTHORIZED'); var token=crmId_()+crmId_(); CacheService.getScriptCache().put('session:'+token,JSON.stringify({userId:user.id}),21600); crmAudit_(user,'LOGIN','Users',user.id,{}); return {sessionId:token,user:crmUserSafe_(user)}; }
function crmSession_(token){ if(!token)throw new Error('UNAUTHORIZED'); var raw=CacheService.getScriptCache().get('session:'+token); if(!raw)throw new Error('UNAUTHORIZED'); var s=JSON.parse(raw), user=crmFind_('Users',s.userId); if(!(user.active===true||String(user.active)==='true'))throw new Error('UNAUTHORIZED'); return crmUserSafe_(user); }
function crmLogout_(token){if(token)CacheService.getScriptCache().remove('session:'+token);return {loggedOut:true};}
function crmSetupFirstBoss(email,password,name){ var lock=LockService.getScriptLock();lock.waitLock(10000);try{if(crmRows_('Users').length)throw new Error('CONFLICT');crmRequire_({email:email,password:password,name:name},['email','password','name']);if(String(password).length<12)throw new Error('VALIDATION');var salt=crmId_();return crmInsert_('Users',{email:String(email).toLowerCase(),name:name,role:'BOSS',active:true,passwordSalt:salt,passwordHash:crmHash_(password,salt)});}finally{lock.releaseLock();} }
