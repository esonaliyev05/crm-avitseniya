function crmAttendance_(user,data){CRM.permission(user,['BOSS','ADMIN','TEACHER']);var lessons=crmRows_('Lessons').filter(function(l){return (!data.groupId||l.groupId===data.groupId)&&(!data.date||String(l.lessonDate).slice(0,10)===data.date)&&l.status!=='CANCELLED';}), students=crmRows_('Students'),att=crmRows_('Attendance');return att.filter(function(a){return lessons.some(function(l){return l.id===a.lessonId;});}).map(function(a){var l=lessons.filter(function(x){return x.id===a.lessonId;})[0];a.studentName=(students.filter(function(x){return x.id===a.studentId;})[0]||{}).fullName||'';a.lessonDate=l.lessonDate;return a;});}
function crmSaveAttendance_(user,data){CRM.permission(user,['BOSS','ADMIN','TEACHER']);crmRequire_(data,['lessonId','records']);var lesson=crmFind_('Lessons',data.lessonId);if(lesson.status==='CANCELLED')throw new Error('VALIDATION');if(user.role==='TEACHER'&&crmFind_('Groups',lesson.groupId).teacherId!==user.id)throw new Error('FORBIDDEN');var allowed=['PRESENT','ABSENT','LATE','EXCUSED'];var lock=LockService.getScriptLock();lock.waitLock(10000);try{data.records.forEach(function(r){if(allowed.indexOf(r.status)<0)throw new Error('VALIDATION');var old=crmRows_('Attendance').filter(function(a){return a.lessonId===data.lessonId&&a.studentId===r.studentId;})[0];if(old)crmUpdate_('Attendance',old.id,{status:r.status,markedBy:user.id});else crmInsert_('Attendance',{lessonId:data.lessonId,studentId:r.studentId,status:r.status,markedBy:user.id});});}finally{lock.releaseLock();}crmAudit_(user,'SAVE_ATTENDANCE','Lessons',lesson.id,{count:data.records.length});return {saved:data.records.length};}
