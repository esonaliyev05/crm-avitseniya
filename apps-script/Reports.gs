function crmDashboard_(user){CRM.permission(user,['BOSS','ADMIN','TEACHER']);var students=crmRows_('Students').filter(function(s){return s.status!=='ARCHIVED';}),groups=crmGroups_(user),payments=user.role==='TEACHER'?[]:crmRows_('Payments').filter(function(p){return p.status==='COMPLETED';}),debt=user.role==='TEACHER'?0:crmDebtors_(user).reduce(function(n,d){return n+d.debt;},0), byMonth={};payments.forEach(function(p){var k=String(p.paidAt).slice(0,7);byMonth[k]=(byMonth[k]||0)+Number(p.amountMinor||0)/100;});var monthly=Object.keys(byMonth).sort().slice(-12).map(function(k){return {month:k,amount:byMonth[k]};});return {students:students.length,groups:groups.length,revenue:payments.reduce(function(n,p){return n+Number(p.amountMinor||0)/100;},0),debt:debt,monthly:monthly,maxRevenue:Math.max.apply(null,[1].concat(monthly.map(function(x){return x.amount;})))};}
function crmReports_(user){CRM.permission(user,['BOSS','ADMIN']);return {dashboard:crmDashboard_(user),debtors:crmDebtors_(user),generatedAt:crmNow_()};}
function crmExportCsv_(user){CRM.permission(user,['BOSS','ADMIN']);var rows=crmDebtors_(user),out=['studentName,period,debt'].concat(rows.map(function(r){return [r.studentName,r.period,r.debt].map(function(v){return '"'+String(v).replace(/"/g,'""')+'"';}).join(',');}));return {csv:out.join('\n')};}
