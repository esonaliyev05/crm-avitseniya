function crmGroups_(user){CRM.permission(user,['BOSS','ADMIN','TEACHER']);var groups=crmRows_('Groups'),courses=crmRows_('Courses'),users=crmRows_('Users'),members=crmRows_('GroupStudents');if(user.role==='TEACHER')groups=groups.filter(function(g){return String(g.teacherId)===user.id;});return groups.map(function(g){g.courseName=(courses.filter(function(c){return c.id===g.courseId;})[0]||{}).name||'';g.teacherName=(users.filter(function(u){return u.id===g.teacherId;})[0]||{}).name||'';g.studentCount=members.filter(function(m){return m.groupId===g.id&&!m.leftAt;}).length;return g;});}
function crmAssignStudent_(user,data){CRM.permission(user,['BOSS','ADMIN']);crmRequire_(data,['groupId','studentId']);var existing=crmRows_('GroupStudents').filter(function(x){return x.groupId===data.groupId&&x.studentId===data.studentId&&!x.leftAt;})[0];if(existing)throw new Error('CONFLICT');var o=crmInsert_('GroupStudents',{groupId:data.groupId,studentId:data.studentId,joinedAt:crmNow_()});crmAudit_(user,'ASSIGN_STUDENT','GroupStudents',o.id,data);return o;}
