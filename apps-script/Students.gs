function crmStudents_(user,data){ CRM.permission(user,['BOSS','ADMIN','TEACHER']);var q=String(data.q||'').toLowerCase();return crmRows_('Students').filter(function(s){return String(s.status)!=='ARCHIVED'&&(String(s.fullName).toLowerCase().indexOf(q)>=0||String(s.phone).indexOf(q)>=0);}); }
function crmCreateStudent_(user,data){CRM.permission(user,['BOSS','ADMIN']);crmRequire_(data,['fullName']);if(data.phone&&!/^\+?[0-9]{9,15}$/.test(String(data.phone).replace(/[ -]/g,'')))throw new Error('VALIDATION');var out=crmInsert_('Students',{fullName:data.fullName,phone:data.phone||'',parentPhone:data.parentPhone||'',smsConsent:data.smsConsent===true,status:'ACTIVE'});crmAudit_(user,'CREATE','Students',out.id,{});return out;}
function crmUpdateStudent_(user,data){CRM.permission(user,['BOSS','ADMIN']);var allowed={fullName:data.fullName,phone:data.phone,parentPhone:data.parentPhone,smsConsent:data.smsConsent};var out=crmUpdate_('Students',data.id,allowed);crmAudit_(user,'UPDATE','Students',out.id,{});return out;}
function crmArchiveStudent_(user,data){CRM.permission(user,['BOSS','ADMIN']);var out=crmUpdate_('Students',data.id,{status:'ARCHIVED'});crmAudit_(user,'ARCHIVE','Students',out.id,{});return out;}
