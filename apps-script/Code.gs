function doGet(e){try{var action=e.parameter.action;if(action==='health')return crmResponse_({status:'ok'});return crmError_('NOT_FOUND');}catch(err){return crmError_(err);}}
function doPost(e){try{var body=JSON.parse(e.postData.contents||'{}'),action=body.action,data=body.data||{},token=body.sessionToken||''; var publicActions={login:1}; if(publicActions[action])return crmResponse_(crmLogin_(data)); var user=crmSession_(token);var map={'logout':function(){return crmLogout_(token);},'session':function(){return {user:user};},'dashboard':function(){return crmDashboard_(user);},'students.list':function(){return crmStudents_(user,data);},'students.create':function(){return crmCreateStudent_(user,data);},'students.update':function(){return crmUpdateStudent_(user,data);},'students.archive':function(){return crmArchiveStudent_(user,data);},'groups.list':function(){return crmGroups_(user);},'groups.assignStudent':function(){return crmAssignStudent_(user,data);},'attendance.list':function(){return crmAttendance_(user,data);},'attendance.save':function(){return crmSaveAttendance_(user,data);},'payments.list':function(){return crmPayments_(user,data);},'payments.create':function(){return crmCreatePayment_(user,data);},'payments.void':function(){return crmVoidPayment_(user,data);},'payments.debtors':function(){return crmDebtors_(user);},'notifications.list':function(){return crmNotifications_(user,data);},'notifications.read':function(){return crmReadNotification_(user,data);},'sms.send':function(){return crmSendSms_(user,data);},'reports.dashboard':function(){return crmReports_(user);},'reports.csv':function(){return crmExportCsv_(user);}};if(!map[action])throw new Error('NOT_FOUND');return crmResponse_(map[action]());}catch(err){return crmError_(err);}}
function crmSetupSpreadsheet(){var ss=SpreadsheetApp.create('Avitseniya Academy CRM');PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId());Object.keys(CRM.SHEETS).forEach(function(name){var sh=ss.getSheetByName(name)||ss.insertSheet(name);sh.clear();sh.getRange(1,1,1,CRM.SHEETS[name].length).setValues([CRM.SHEETS[name]]);sh.setFrozenRows(1);sh.getRange(1,1,1,CRM.SHEETS[name].length).setFontWeight('bold');});var first=ss.getSheets()[0];if(first.getName()==='Sheet1')ss.deleteSheet(first);return ss.getUrl();}
