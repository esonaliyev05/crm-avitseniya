function crmPayments_(user,data){CRM.permission(user,['BOSS','ADMIN']);var students=crmRows_('Students');return crmRows_('Payments').filter(function(p){return !data.studentId||p.studentId===data.studentId;}).map(function(p){p.studentName=(students.filter(function(s){return s.id===p.studentId;})[0]||{}).fullName||'';p.amount=Number(p.amountMinor||0)/100;return p;});}
function crmCreatePayment_(user,data){CRM.permission(user,['BOSS','ADMIN']);crmRequire_(data,['studentId','obligationId','amount','method','idempotencyKey']);var lock=LockService.getScriptLock();lock.waitLock(10000);try{var previous=crmRows_('Payments').filter(function(p){return p.idempotencyKey===data.idempotencyKey;})[0];if(previous)return previous;var obligation=crmFind_('PaymentObligations',data.obligationId);if(obligation.studentId!==data.studentId)throw new Error('VALIDATION');var amount=crmMinor_(data.amount);if(amount<=0)throw new Error('VALIDATION');var o=crmInsert_('Payments',{studentId:data.studentId,obligationId:data.obligationId,amountMinor:amount,paidAt:crmNow_(),method:data.method,receivedBy:user.id,status:'COMPLETED',idempotencyKey:data.idempotencyKey,note:data.note||'',voidReason:''});crmAudit_(user,'CREATE_PAYMENT','Payments',o.id,{amountMinor:amount});return o;}finally{lock.releaseLock();}}
function crmVoidPayment_(user,data){CRM.permission(user,['BOSS']);crmRequire_(data,['id','reason']);var payment=crmFind_('Payments',data.id);if(payment.status==='VOID')throw new Error('CONFLICT');var out=crmUpdate_('Payments',data.id,{status:'VOID',voidReason:data.reason});crmAudit_(user,'VOID_PAYMENT','Payments',data.id,{reason:data.reason});return out;}
function crmDebtors_(user){CRM.permission(user,['BOSS','ADMIN']);var students=crmRows_('Students'),payments=crmRows_('Payments');return crmRows_('PaymentObligations').map(function(o){var paid=payments.filter(function(p){return p.obligationId===o.id&&p.status==='COMPLETED';}).reduce(function(n,p){return n+Number(p.amountMinor||0);},0);var debt=Math.max(0,Number(o.amountMinor||0)-Number(o.discountMinor||0)-paid);return {id:o.id,studentId:o.studentId,studentName:(students.filter(function(s){return s.id===o.studentId;})[0]||{}).fullName||'',period:o.period,debt:debt/100,dueDate:o.dueDate};}).filter(function(x){return x.debt>0;});}
